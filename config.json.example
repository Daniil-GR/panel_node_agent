{
  "domain": "node-1.example.com",
  "serverIp": "203.0.113.10",
  "adminEmail": "admin@example.com",
  "adminUser": "admin",
  "adminPassHash": "$2a$12$replace-with-bcrypt-hash",
  "naivePort": 443,
  "mieruPortStart": 2012,
  "mieruPortEnd": 2022,
  "panelPort": 3000,
  "panelHost": "127.0.0.1",
  "exposePanel": false,
  "useUfw": true,
  "dbPath": "/var/lib/rixxx-panel/db.sqlite",
  "caddyBin": "/usr/local/bin/caddy-naive",
  "caddyFile": "/etc/caddy-naive/Caddyfile",
  "caddyConfigDir": "/etc/caddy-naive",
  "fakeSiteDir": "/var/www/fake-site",
  "fakeSiteUrl": "https://www.example.com",
  "probeSecret": "",
  "probeMode": "bare",
  "nodeApiKey": "replace-with-long-random-secret",
  "backendAllowedIps": ["127.0.0.1"],
  "allowAnyBackendIp": false,
  "sessionTtlMinutes": 10,
  "authAuditLogPath": "/var/log/caddy-naive/auth-audit.log",
  "trafficAuditLogPath": "/var/log/caddy-naive/traffic-audit.log",
  "ipHistoryTtlHours": 24,
  "maxUniqueIpsPerUser": 5,
  "enforceIpLimit": false,
  "subscriptionBaseUrl": "",
  "mitaStateFile": "/var/lib/rixxx-panel/mita-state.json",
  "trafficPattern": "NOOP",
  "mtu": 1400,
  "udpEnabled": false,
  "language": "ru",
  "version": "1.2.6"
}
